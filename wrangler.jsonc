{
	"name": "line-translate-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-27",
	"observability": {
		"enabled": true,
	},
	"vars": {
		"OPENAI_MODEL": "gpt-4o-mini",
		"OPENAI_FALLBACK_MODEL": "gpt-4.1-mini",
		"TRANSLATION_MODE": "auto",
		"TRANSLATION_STYLE": "casual",
		"TRIGGER_MODE": "direct",
		"TRIGGER_MENTION": "@翻譯",
		"GROUP_TRANSLATION_ENABLED": "true",
		"AUTO_TRANSLATION_ENABLED": "true",
		"DEBUG_LOG": "false",
		"MAX_INPUT_CHARS": "1200",
		"MAX_OUTPUT_TOKENS": "800",
		"OPENAI_TIMEOUT_MS": "8000",
		"MAX_WEBHOOK_BODY_BYTES": "65536",
		"RATE_LIMIT_PER_MIN": "20",
		"IDEMPOTENCY_TTL_SECONDS": "300",
		"ERROR_REPLY_ENABLED": "true"
	},
	"queues": {
		"producers": [{ "binding": "LINE_EVENT_QUEUE", "queue": "line-translate-events" }],
		"consumers": [{ "queue": "line-translate-events", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "retry_delay": 1, "max_concurrency": 10 }]
	},
	"durable_objects": {
		"bindings": [{ "name": "TRANSLATION_GUARD", "class_name": "TranslationGuard" }]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["TranslationGuard"] }
	]
}
