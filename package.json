{
	"name": "line-translate-worker",
	"version": "0.0.0",
	"private": true,
	"description": "LINE bot translation worker powered by OpenAI and Cloudflare Workers.",
	"packageManager": "pnpm@11.7.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"deploy": "node scripts/deploy.mjs",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"cf-typegen": "wrangler types",
		"test:release": "node --test test-release/*.test.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.8.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "~5.1.0",
		"wrangler": "^4.162.0"
	}
}
